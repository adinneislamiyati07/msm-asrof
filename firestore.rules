rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reservations/{reservationId} {
      allow create: if request.resource.data.status == "pending";
      allow read, update, delete: if request.auth != null;
    }

    match /busAvailability/{reservationId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(["busUnits", "tanggal", "durasi"])
        && request.resource.data.keys().hasAll(["busUnits", "tanggal", "durasi"])
        && request.resource.data.busUnits is list
        && request.resource.data.tanggal is string
        && request.resource.data.durasi is number;
      allow delete: if request.auth != null;
    }
  }
}
